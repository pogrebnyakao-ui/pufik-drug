<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing is copied to the cloud backup or to a new phone (device transfer).
     The game has its own manual transfer code in the parent menu.
     "root" covers the whole app data folder, including the WebView storage with the saved pet.
     The app never uses device-protected storage, so no device_* domains are needed. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
