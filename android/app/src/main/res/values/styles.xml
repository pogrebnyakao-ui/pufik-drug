<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Theme of the running game (BridgeActivity switches to it in onCreate).
         Light parent: the game has a single bright look, so native pickers of the
         parent menu (select, time) stay light in system dark mode too.
         windowBackground is the colour around the WebView (cutout / system bar
         padding, see MainActivity) and must stay a plain colour: Capacitor's
         SystemBars plugin copies it to the decor view background. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/pufik_background</item>
    </style>


    <!-- Launch theme: Android 12+ system splash = icon on pufik_background;
         older Android shows @drawable/splash (made by @capacitor/assets from assets/splash.png). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/pufik_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
